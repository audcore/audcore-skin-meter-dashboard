{
  "id": "cn.audcore.signal-hud",
  "name": "Signal HUD",
  "author": "17o2r",
  "version": "1.0.0",
  "api": {
    "major": 1,
    "minor": 0
  },
  "entry": "web/hud.html",
  "window": {
    "default": [
      1000,
      620
    ],
    "min": [
      340,
      300
    ],
    "max": null,
    "resizable": true,
    "maximizable": true
  },
  "themes": [
    "dark",
    "light"
  ],
  "scale": {
    "min": 0.75,
    "max": 2,
    "default": 1
  },
  "languages": [
    "zh",
    "en",
    "ja"
  ],
  "preview": "assets/preview.png",
  "kind": "web",
  "license": "MIT",
  "repository": "https://github.com/audcore/audcore-skin-signal-hud",
  "description": "Signal HUD，声核独立网页皮肤",
  "build": {
    "schema": 1,
    "recipe": "web-static",
    "platform": "windows-x86_64",
    "toolchain": {
      "tools": {
        "node": "24.12.0"
      }
    },
    "files": [
      "LICENSE",
      "assets/preview.png",
      "web/channel-color.mjs",
      "web/channel-name.mjs",
      "web/hud.css",
      "web/hud.html",
      "web/hud.mjs",
      "web/i18n-cache.mjs",
      "web/latency.mjs",
      "web/link-slots.mjs",
      "web/meters.mjs",
      "web/page.mjs",
      "web/pending-toggle.mjs",
      "web/send-label.mjs",
      "web/send-targets.mjs",
      "web/skin-menu.css",
      "web/skin-menu.mjs",
      "web/skin.css",
      "web/skin.mjs",
      "web/startup.mjs",
      "web/studio.css",
      "web/transport-control.mjs",
      "web/webview-bridge.mjs",
      "web/window-controls.mjs"
    ]
  }
}
